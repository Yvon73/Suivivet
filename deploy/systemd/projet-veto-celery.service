[Unit]
Description=Celery worker - Projet_veto (rappels de consultation par email)
After=network.target redis-server.service postgresql.service
Wants=redis-server.service postgresql.service

[Service]
Type=simple
# Meme utilisateur que le service gunicorn (site ISPConfig suivivet.fr).
User=web2
Group=client0
WorkingDirectory=/opt/projet_veto
Environment=HOME=/opt/projet_veto
Environment=MPLCONFIGDIR=/opt/projet_veto/.cache/matplotlib
# Charge Projet_veto/.env lui-meme (django-environ), comme le service gunicorn.
ExecStart=/opt/projet_veto/.venv/bin/celery -A Projet_veto worker -l info
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/projet_veto/media /opt/projet_veto/logs

[Install]
WantedBy=multi-user.target
