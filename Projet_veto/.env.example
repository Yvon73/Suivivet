# Copie ce fichier en ".env" (même dossier) et renseigne les vraies valeurs.
# Ne jamais commiter le ".env" lui-même (déjà exclu par .gitignore) : lui seul
# contient des secrets réels (mot de passe DB, mot de passe email, clé secrète...).

# --- Obligatoires ------------------------------------------------------------

# Clé secrète Django (signature des sessions, tokens...). À générer une fois,
# longue et aléatoire, jamais réutilisée d'un environnement à l'autre :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Connexion PostgreSQL, format DSN : postgres://utilisateur:mot_de_passe@hote:5432/nom_base
# Le rôle a besoin de CREATEDB (manage.py test crée/détruit une base de test à
# chaque lancement) ; la base elle-même doit déjà exister (CREATE DATABASE).
DB_URL=postgres://mon_user:mot_de_passe@localhost:5432/Projet_veto

# Serveur SMTP d'envoi (rappels de consultation, notifications...). Attention :
# même en dev, un envoi réel part vers ce serveur — pas de sandbox par défaut.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Production (à adapter en quittant le développement local) --------------

# False en production : ne jamais laisser True (fuite d'informations de debug
# au public en cas d'erreur).
DEBUG=False

# Domaines/IP autorisés à servir l'application, séparés par des virgules.
ALLOWED_HOSTS=exemple.fr,www.exemple.fr

# Origines autorisées à poster un formulaire (HTTPS obligatoire), si le nom de
# domaine public diffère de ALLOWED_HOSTS ou pour un sous-domaine spécifique.
CSRF_TRUSTED_ORIGINS=https://exemple.fr,https://www.exemple.fr

# À True uniquement si un reverse-proxy de confiance (nginx, load-balancer...)
# termine le HTTPS et transmet l'en-tête X-Forwarded-Proto — sinon laisser False.
BEHIND_REVERSE_PROXY=False

# Contacts techniques : reçoivent un email sur toute erreur serveur (500) une
# fois DEBUG=False. Format "Nom:email", plusieurs entrées séparées par des virgules.
ADMINS=

# Expéditeur des emails techniques envoyés à Django lui-même (erreurs serveur...).
# Par défaut, reprend EMAIL_HOST_USER si non renseigné.
SERVER_EMAIL=

# Niveau de journalisation global (DEBUG/INFO/WARNING/ERROR). Par défaut : DEBUG
# en développement (DEBUG=True), INFO en production.
LOG_LEVEL=
DJANGO_LOG_LEVEL=INFO

# Connexions DB persistantes (secondes) sous gunicorn ; 0 = une connexion par
# requête (par défaut en dev). 60 est un bon point de départ en production.
CONN_MAX_AGE=

# --- Optionnelles (valeurs par défaut sensées sans elles) --------------------

# Broker/backend Celery (rappels de consultation asynchrones) ; par défaut un
# Redis local. À pointer vers un Redis dédié en production.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cookies de session/CSRF marqués Secure (HTTPS uniquement) ; par défaut aligné
# sur DEBUG (False en dev, True en prod) — à ne forcer que pour un cas particulier.
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=

# Redirection HTTP -> HTTPS et durée du HSTS (secondes) ; par défaut alignés
# sur DEBUG (désactivés en dev, activés en prod).
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=

# Informations légales affichées sur la page d'accueil (mentions légales, RGPD)
# — obligatoires pour un site européen, même pour un usage personnel non
# professionnel. Sans elles, des placeholders visibles s'affichent à la place.
EDITEUR_NOM=
EDITEUR_ADRESSE=
EDITEUR_EMAIL=
EDITEUR_TELEPHONE=
HEBERGEUR_NOM=
HEBERGEUR_ADRESSE=
